# Never commit a populated .env file.
RAILWAY_ENV=local
LOG_LEVEL=INFO

# Snowflake (required only when loading / transforming warehouse data)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=RAIL_DELAY_ENGINEER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
RAILRADAR_API_KEY=
SNOWFLAKE_DATABASE=RAIL_DELAY_ANALYTICS
SNOWFLAKE_SCHEMA=RAW

# Optional, third-party current-status adapter. Do not add an NTES/IRCTC credential.
RAILRADAR_API_KEY=
